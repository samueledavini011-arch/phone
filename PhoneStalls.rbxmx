<roblox version="4">
  <Item class="ModuleScript" referent="0">
    <Properties>
      <string name="Name">PhoneStalls</string>
      <string name="Source"><![CDATA[--!strict
--[[
	PhoneStalls  (ModuleScript)

	Gives your BUY and SELL stalls a new look: a fluted counter with a
	marble top, warm wooden back wall with stocked shelves, a menu board,
	a big flickering neon sign, an OPEN sign, glowing floor circles with a
	spinning icon above them, and real lights.

	Your shopkeepers and your buy/sell scripts are not touched. The old
	stall's parts are only made invisible (players can still step on, touch
	or use its floor circle and prompts), and the new look is built around
	the shopkeeper.

	HOW TO USE (Roblox Studio)
	  1. Put PhoneStalls in ServerStorage.
	  2. Click your old BUY stall in the 3D view so it is selected.
	  3. Open View > Command Bar, paste this line and press Enter:

	       require(game.ServerStorage.PhoneStalls).ReplaceSelected()

	  4. Do the same for the SELL stall.

	The shopkeepers keep their own look. To dress them in your Roblox
	avatar, or take it off again:
	    require(game.ServerStorage.PhoneStalls).DressShopkeepers()
	    require(game.ServerStorage.PhoneStalls).UndressShopkeepers()

	Want the old look back? Select the stall and run:
	    require(game.ServerStorage.PhoneStalls).Restore()
	Changed StallConfig, or got a newer PhoneStalls? Run:
	    require(game.ServerStorage.PhoneStalls).Rebuild()
]]

local CollectionService = game:GetService("CollectionService")
local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local ServerStorage = game:GetService("ServerStorage")
local StarterPlayer = game:GetService("StarterPlayer")

local StallGeometry = require(script:WaitForChild("StallGeometry"))

type Stall = StallGeometry.Stall
type Fit = StallGeometry.Fit
type Prim = StallGeometry.Prim
type RGB = StallGeometry.RGB

export type BuildOptions = {
	cframe: CFrame?, -- where the bottom centre goes; the counter faces its LookVector
	fit: Fit?,
	parent: Instance?,
}

local PhoneStalls = {}

local VERSION = 2 -- bump when StallFX changes, so old copies get replaced
local SAVED = "PhoneStallsSaved_" -- prefix for the old stall's saved looks
local SIGN_FONT = Enum.Font.FredokaOne
local TEXT_FONT = Enum.Font.GothamMedium

local function rgb(c: RGB): Color3
	return Color3.fromRGB(c[1], c[2], c[3])
end

local function make(className: string, props: { [string]: any }, parent: Instance?): any
	local inst = Instance.new(className) :: any
	for k, v in props do
		inst[k] = v
	end
	if parent then
		inst.Parent = parent
	end
	return inst
end

-- A fresh copy every time, so edits to StallConfig count straight away.
local function loadConfig(): { Stall }
	local source = script:FindFirstChild("StallConfig")
	if not source or not source:IsA("ModuleScript") then
		error("[PhoneStalls] StallConfig is missing. It should be inside PhoneStalls.")
	end
	local copy = source:Clone()
	copy.Parent = script
	local ok, result = pcall(require, copy)
	copy:Destroy()
	if not ok or type(result) ~= "table" then
		error("[PhoneStalls] StallConfig has a mistake in it: " .. tostring(result))
	end
	return result :: any
end

local function stallNames(stalls: { Stall }): string
	local names = {}
	for _, s in stalls do
		table.insert(names, `"{s.Name or "?"}"`)
	end
	return table.concat(names, ", ")
end

-- Finds a stall by its name, sign or kind somewhere in `words`.
local function findStall(stalls: { Stall }, words: string): Stall?
	local text = string.lower(words)
	if text == "" then
		return nil
	end
	for _, s in stalls do
		if string.lower(s.Name or "") == text then
			return s
		end
	end
	for _, s in stalls do
		for _, word in { s.Sign, s.Kind } do
			if word and word ~= "" and string.find(text, string.lower(word), 1, true) then
				return s
			end
		end
	end
	return nil
end

--------------------------------------------------------------------------
-- Screens and signs
--------------------------------------------------------------------------

local function surface(part: BasePart, face: Enum.NormalId, pixelsHigh: number, brightness: number): (SurfaceGui, number)
	local size = part.Size
	local w, h = size.X, size.Y
	if face == Enum.NormalId.Top or face == Enum.NormalId.Bottom then
		h = size.Z
	elseif face == Enum.NormalId.Left or face == Enum.NormalId.Right then
		w = size.Z
	end
	local gui = make("SurfaceGui", {
		Name = "Screen",
		Face = face,
		SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud,
		PixelsPerStud = pixelsHigh / h,
		LightInfluence = 0,
		Brightness = brightness,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
	}, part)
	return gui, w * gui.PixelsPerStud
end

local function label(parent: Instance, text: string, font: Enum.Font, color: Color3, x: number, y: number, w: number, h: number, align: Enum.TextXAlignment?): TextLabel
	return make("TextLabel", {
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0, 0),
		Position = UDim2.fromScale(x, y),
		Size = UDim2.fromScale(w, h),
		Font = font,
		Text = text,
		TextScaled = true,
		TextColor3 = color,
		TextXAlignment = align or Enum.TextXAlignment.Center,
	}, parent)
end

local function drawIcon(parent: Instance, icon: string, size: number, color: Color3)
	local holder = make("Frame", {
		Name = "Icon",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(size, size),
	}, parent)
	local function piece(x: number, y: number, w: number, h: number, round: number, z: number): Frame
		local f = make("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(x, y),
			Size = UDim2.fromScale(w, h),
			BackgroundColor3 = color,
			BorderSizePixel = 0,
			ZIndex = z,
		}, holder)
		make("UICorner", { CornerRadius = UDim.new(round, 0) }, f)
		return f
	end
	local function outline(f: Frame, thickness: number)
		f.BackgroundTransparency = 1
		make("UIStroke", { Color = color, Thickness = thickness }, f)
	end

	if string.find(icon, "://", 1, true) then
		make("ImageLabel", { BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Image = icon, ImageColor3 = color }, holder)
	elseif icon == "bag" then
		piece(0.5, 0.63, 0.68, 0.56, 0.14, 2)
		outline(piece(0.5, 0.36, 0.34, 0.36, 0.5, 1), size * 0.075)
	elseif icon == "cash" then
		outline(piece(0.5, 0.5, 0.86, 0.86, 0.5, 1), size * 0.07)
		local dollar = label(holder, "$", SIGN_FONT, color, 0.2, 0.14, 0.6, 0.72)
		dollar.ZIndex = 2
	elseif icon == "phone" then
		outline(piece(0.5, 0.5, 0.5, 0.86, 0.18, 1), size * 0.065)
		piece(0.5, 0.17, 0.14, 0.035, 0.5, 2)
		piece(0.5, 0.82, 0.1, 0.06, 0.5, 2)
	end
end

local function neonText(parent: Instance, text: string, accent: Color3)
	local core = accent:Lerp(Color3.new(1, 1, 1), 0.62)
	for _, layer in { { color = accent, text = 0.45, stroke = 16, strokeT = 0.82 }, { color = core, text = 0, stroke = 6, strokeT = 0.05 } } do
		local l = label(parent, text, SIGN_FONT, layer.color, 0.07, 0.13, 0.86, 0.74)
		l.TextTransparency = layer.text
		make("UIStroke", { Color = accent, Thickness = layer.stroke, Transparency = layer.strokeT, LineJoinMode = Enum.LineJoinMode.Round }, l)
	end
end

local function drawGui(part: BasePart, g: StallGeometry.Gui, face: Enum.NormalId)
	local accent = rgb(g.color)
	local white = Color3.new(1, 1, 1)
	if g.kind == "sign" then
		local gui = surface(part, face, 300, 2.5)
		neonText(gui, g.text, accent)
	elseif g.kind == "open" then
		local gui = surface(part, face, 120, 2.5)
		local pill = make("Frame", {
			BackgroundTransparency = 1,
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromScale(0.92, 0.8),
		}, gui)
		make("UICorner", { CornerRadius = UDim.new(0.5, 0) }, pill)
		make("UIStroke", { Color = accent, Thickness = 6 }, pill)
		local l = label(gui, g.text, SIGN_FONT, accent:Lerp(white, 0.55), 0.18, 0.2, 0.64, 0.6)
		make("UIStroke", { Color = accent, Thickness = 3, Transparency = 0.3 }, l)
	elseif g.kind == "menu" then
		local gui = surface(part, face, 240, 1.3)
		local bg = make("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0 }, gui)
		make("UIGradient", { Color = ColorSequence.new(Color3.fromRGB(26, 26, 32), Color3.fromRGB(10, 10, 12)), Rotation = 90 }, bg)
		local lines = g.lines
		local head = label(gui, lines[1] or "", SIGN_FONT, accent, 0.06, 0.08, 0.88, 0.3, Enum.TextXAlignment.Left)
		make("UIStroke", { Color = accent, Thickness = 2, Transparency = 0.7 }, head)
		make("Frame", { Position = UDim2.new(0.06, 0, 0.43, 0), Size = UDim2.new(0.88, 0, 0, 3), BackgroundColor3 = accent, BorderSizePixel = 0 }, gui)
		for i = 2, math.min(#lines, 3) do
			local color = if i == #lines then accent:Lerp(white, 0.5) else white
			label(gui, lines[i], TEXT_FONT, color, 0.06, 0.52 + (i - 2) * 0.22, 0.88, 0.16, Enum.TextXAlignment.Left)
		end
	elseif g.kind == "icon" then
		local gui = surface(part, face, 200, 1.8)
		local panel = make("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromScale(0.94, 0.9),
			BackgroundColor3 = accent:Lerp(Color3.new(0, 0, 0), 0.82),
		}, gui)
		make("UICorner", { CornerRadius = UDim.new(0.18, 0) }, panel)
		make("UIStroke", { Color = accent, Thickness = 5 }, panel)
		drawIcon(panel, g.icon, 120, accent)
	elseif g.kind == "token" then
		local gui = surface(part, face, 200, 2.2)
		drawIcon(gui, g.icon, 120, accent:Lerp(white, 0.3))
	elseif g.kind == "screen" then
		local gui = surface(part, face, 250, 1.6)
		local bg = make("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = white, BorderSizePixel = 0 }, gui)
		make("UICorner", { CornerRadius = UDim.new(0.1, 0) }, bg)
		make("UIGradient", {
			Color = ColorSequence.new(accent, Color3.fromRGB(110, 60, 220)),
			Rotation = 120,
		}, bg)
		label(gui, "9:41", TEXT_FONT, white, 0.3, 0.1, 0.4, 0.12)
		for row = 0, 1 do
			for col = 0, 2 do
				local app = make("Frame", {
					Position = UDim2.fromScale(0.14 + col * 0.26, 0.5 + row * 0.18),
					Size = UDim2.fromScale(0.2, 0.11),
					BackgroundColor3 = white,
					BackgroundTransparency = 0.45,
					BorderSizePixel = 0,
				}, gui)
				make("UICorner", { CornerRadius = UDim.new(0.3, 0) }, app)
			end
		end
	elseif g.kind == "display" then
		local gui = surface(part, face, 120, 1.6)
		label(gui, g.text, Enum.Font.GothamBold, accent, 0.1, 0.2, 0.8, 0.6)
	elseif g.kind == "ticker" then
		-- LED strip; StallFX scrolls the two copies of the text along
		local gui = surface(part, face, 100, 1.8)
		make("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.fromRGB(6, 6, 8), BorderSizePixel = 0 }, gui)
		local track = make("Frame", {
			Name = "Track",
			Position = UDim2.fromScale(0.01, 0.12),
			Size = UDim2.fromScale(0.98, 0.76),
			BackgroundTransparency = 1,
			ClipsDescendants = true,
		}, gui)
		for _, name in { "A", "B" } do
			local l = make("TextLabel", {
				Name = name,
				BackgroundTransparency = 1,
				AutomaticSize = Enum.AutomaticSize.X,
				Size = UDim2.new(0, 0, 1, 0),
				Position = UDim2.fromOffset(if name == "A" then 0 else 4000, 0),
				Font = Enum.Font.Arcade,
				Text = g.text .. "    ",
				TextSize = 60,
				TextColor3 = accent:Lerp(white, 0.25),
				TextXAlignment = Enum.TextXAlignment.Left,
			}, track)
			make("UIStroke", { Color = accent, Thickness = 2, Transparency = 0.6 }, l)
		end
	elseif g.kind == "poster" then
		local gui = surface(part, face, 240, 1.4)
		local bg = make("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = white, BorderSizePixel = 0 }, gui)
		make("UIGradient", { Color = ColorSequence.new(accent:Lerp(Color3.new(0, 0, 0), 0.55), Color3.fromRGB(8, 8, 12)), Rotation = 90 }, bg)
		make("UIStroke", { Color = accent, Thickness = 4 }, bg)
		local phone = make("Frame", {
			Position = UDim2.fromScale(0.07, 0.12),
			Size = UDim2.fromScale(0.25, 0.76),
			BackgroundColor3 = Color3.fromRGB(18, 18, 24),
		}, gui)
		make("UICorner", { CornerRadius = UDim.new(0.14, 0) }, phone)
		make("UIStroke", { Color = accent:Lerp(white, 0.3), Thickness = 3 }, phone)
		drawIcon(phone, g.icon, 60, accent)
		local lines = g.lines
		local head = label(gui, lines[1] or "", SIGN_FONT, accent:Lerp(white, 0.35), 0.38, 0.16, 0.58, 0.34, Enum.TextXAlignment.Left)
		make("UIStroke", { Color = accent, Thickness = 2, Transparency = 0.5 }, head)
		label(gui, lines[2] or "", TEXT_FONT, white, 0.38, 0.56, 0.58, 0.13, Enum.TextXAlignment.Left)
		if lines[3] then
			local badge = make("Frame", { Position = UDim2.fromScale(0.38, 0.75), Size = UDim2.fromScale(0.24, 0.13), BackgroundColor3 = accent }, gui)
			make("UICorner", { CornerRadius = UDim.new(0.5, 0) }, badge)
			label(badge, lines[3], Enum.Font.GothamBold, Color3.fromRGB(10, 10, 14), 0.1, 0.15, 0.8, 0.7)
		end
	elseif g.kind == "board" then
		local gui = surface(part, face, 250, 1)
		local slate = make("Frame", {
			Position = UDim2.fromScale(0.08, 0.06),
			Size = UDim2.fromScale(0.84, 0.88),
			BackgroundColor3 = Color3.fromRGB(32, 40, 37),
		}, gui)
		make("UICorner", { CornerRadius = UDim.new(0.04, 0) }, slate)
		local chalk = Color3.fromRGB(236, 236, 228)
		for i, line in g.lines do
			local first = i == 1
			label(slate, line, Enum.Font.PermanentMarker, if first then accent:Lerp(white, 0.4) else chalk, 0.06, if first then 0.06 else 0.2 + i * 0.13, 0.88, if first then 0.24 else 0.12)
		end
	end
end

local OPPOSITE: { [string]: Enum.NormalId } = {
	Front = Enum.NormalId.Back,
	Back = Enum.NormalId.Front,
	Top = Enum.NormalId.Bottom,
	Bottom = Enum.NormalId.Top,
	Left = Enum.NormalId.Right,
	Right = Enum.NormalId.Left,
}

--------------------------------------------------------------------------
-- Parts
--------------------------------------------------------------------------

local function addLight(part: BasePart, l: StallGeometry.Light)
	if l.kind == "spot" then
		make("SpotLight", {
			Face = (Enum.NormalId :: any)[l.face] or Enum.NormalId.Front,
			Angle = l.angle,
			Range = math.min(60, l.range),
			Brightness = l.brightness,
			Color = rgb(l.color),
		}, part)
	else
		make("PointLight", { Range = math.min(60, l.range), Brightness = l.brightness, Color = rgb(l.color) }, part)
	end
end

local function makePart(p: Prim): BasePart
	local part: Part = Instance.new("Part")
	if p.kind == "cyl" then
		part.Shape = Enum.PartType.Cylinder
	elseif p.kind == "ball" then
		part.Shape = Enum.PartType.Ball
	end
	part.Name = p.name
	part.Anchored = true
	part.CanCollide = p.solid
	part.CanQuery = p.solid
	part.CanTouch = false
	part.CastShadow = p.shadow
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Size = Vector3.new(p.size[1], p.size[2], p.size[3])
	local r = p.rot
	part.CFrame = CFrame.new(p.pos[1], p.pos[2], p.pos[3], r[1], r[2], r[3], r[4], r[5], r[6], r[7], r[8], r[9])
	part.Material = (Enum.Material :: any)[p.material] or Enum.Material.SmoothPlastic
	part.Color = rgb(p.color)
	part.Reflectance = p.reflectance
	part.Transparency = p.transparency
	if p.light then
		addLight(part, p.light)
	end
	if p.tag then
		CollectionService:AddTag(part, p.tag)
	end
	if p.sparkles then
		make("ParticleEmitter", {
			Color = ColorSequence.new(rgb(p.sparkles)),
			LightEmission = 1,
			Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.22), NumberSequenceKeypoint.new(1, 0) }),
			Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.2), NumberSequenceKeypoint.new(1, 1) }),
			Lifetime = NumberRange.new(1, 1.8),
			Rate = 6,
			Speed = NumberRange.new(0.3, 0.8),
			SpreadAngle = Vector2.new(180, 180),
			RotSpeed = NumberRange.new(-90, 90),
		}, part)
	end
	local g = p.gui
	if g then
		drawGui(part, g, (Enum.NormalId :: any)[g.face] or Enum.NormalId.Front)
		if g.twoSided then
			drawGui(part, g, OPPOSITE[g.face] or Enum.NormalId.Back)
		end
	end
	return part
end

-- Copies StallFX into StarterPlayerScripts. It spins the floating icons
-- and the turntable, and makes the neon flicker, on each player's screen.
local function installEffects()
	local scripts = StarterPlayer:FindFirstChildOfClass("StarterPlayerScripts")
	local source = script:FindFirstChild("StallFX")
	if not scripts or not source then
		return
	end
	local existing = scripts:FindFirstChild("StallFX")
	if existing and existing:GetAttribute("PhoneStallsVersion") == VERSION then
		return
	end
	if existing then
		existing:Destroy()
	end
	local copy = source:Clone()
	copy:SetAttribute("PhoneStallsVersion", VERSION)
	copy.Parent = scripts
	print("[PhoneStalls] Put StallFX in StarterPlayerScripts. It animates the signs and floating icons.")
end

local function buildStall(s: Stall, options: BuildOptions?): Model
	local o: BuildOptions = options or {}
	local fit: Fit = o.fit or {}
	local shapes = StallGeometry.Shapes(s, fit)
	local name = s.Name or "Stall"

	local model = Instance.new("Model")
	model.Name = name
	local groups: { [string]: Instance } = {}
	for _, m in shapes.motions do
		local g = Instance.new("Model")
		g.Name = m.group
		g.WorldPivot = CFrame.new(m.pivot[1], m.pivot[2], m.pivot[3])
		if m.fx == "spin" then
			g:SetAttribute("Speed", m.speed)
			g:SetAttribute("Bob", m.bob)
			CollectionService:AddTag(g, "StallSpin")
		elseif m.fx == "flicker" then
			CollectionService:AddTag(g, "StallFlicker")
		elseif m.fx == "breathe" then
			g:SetAttribute("Low", m.low)
			g:SetAttribute("High", m.high)
			g:SetAttribute("Radius", m.radius)
			CollectionService:AddTag(g, "StallBreathe")
		end
		g.Parent = model
		groups[m.group] = g
	end
	local function groupFor(group: string): Instance
		local existing = groups[group]
		if existing then
			return existing
		end
		local folder = Instance.new("Folder")
		folder.Name = group
		folder.Parent = model
		groups[group] = folder
		return folder
	end
	for _, p in shapes.prims do
		makePart(p).Parent = groupFor(p.group)
	end

	model.WorldPivot = CFrame.new()
	model:SetAttribute("PhoneStall", name)
	model:SetAttribute("FitWidth", shapes.width)
	model:SetAttribute("FitDepth", shapes.depth)
	model:SetAttribute("FitFloor", fit.floor)
	model:SetAttribute("PadX", fit.padX)
	model:SetAttribute("PadZ", fit.padZ)
	model:SetAttribute("PadR", fit.padR)
	if o.cframe then
		model:PivotTo(o.cframe)
	end
	model.Parent = o.parent or workspace
	installEffects()
	return model
end

--------------------------------------------------------------------------
-- Working out where the old stall is
--------------------------------------------------------------------------

local CORNERS = {
	Vector3.new(-1, -1, -1),
	Vector3.new(-1, -1, 1),
	Vector3.new(-1, 1, -1),
	Vector3.new(-1, 1, 1),
	Vector3.new(1, -1, -1),
	Vector3.new(1, -1, 1),
	Vector3.new(1, 1, -1),
	Vector3.new(1, 1, 1),
}

local function corners(part: BasePart): { Vector3 }
	local half = part.Size / 2
	local out = table.create(8)
	for i, c in CORNERS do
		out[i] = part.CFrame:PointToWorldSpace(c * half)
	end
	return out
end

local function flat(v: Vector3): Vector3?
	local f = Vector3.new(v.X, 0, v.Z)
	if f.Magnitude < 0.01 then
		return nil
	end
	return f.Unit
end

local function isInside(inst: Instance, roots: { Instance }): boolean
	for _, root in roots do
		if inst == root or inst:IsDescendantOf(root) then
			return true
		end
	end
	return false
end

local function topModel(inst: Instance): Instance
	local current = inst
	while true do
		local parent = current.Parent
		if parent and parent ~= workspace and parent:IsA("Model") then
			current = parent
		else
			return current
		end
	end
end

local function descendantsAndSelf(root: Instance): { Instance }
	local all = root:GetDescendants()
	table.insert(all, root)
	return all
end

local function npcRoot(npc: Model): BasePart?
	local humanoid = npc:FindFirstChildOfClass("Humanoid")
	if humanoid and humanoid.RootPart then
		return humanoid.RootPart
	end
	for _, name in { "HumanoidRootPart", "Torso", "UpperTorso", "Head" } do
		local p = npc:FindFirstChild(name)
		if p and p:IsA("BasePart") then
			return p
		end
	end
	return npc.PrimaryPart
end

type Analysis = { cframe: CFrame, fit: Fit, npcs: { Instance }, words: string, padFound: boolean }

local PAD_WORDS = { "pad", "circle", "ring", "zone", "touch", "prompt", "button", "buy", "sell", "trigger" }

local function analyse(old: Instance): Analysis?
	-- Shopkeepers: inside the stall, or standing in it
	local npcs: { Instance } = {}
	local all = descendantsAndSelf(old)
	for _, d in all do
		if d:IsA("Humanoid") and d.Parent and d.Parent:IsA("Model") and d.Parent ~= old then
			table.insert(npcs, d.Parent)
		end
	end

	local parts: { BasePart } = {}
	local words = { old.Name }
	for _, d in all do
		if not isInside(d, npcs) then
			if d:IsA("BasePart") and d.Transparency < 1 then
				table.insert(parts, d)
			elseif d:IsA("TextLabel") or d:IsA("TextButton") then
				table.insert(words, d.Text)
			end
		end
	end
	if #parts == 0 then
		return nil
	end

	local lo, hi = Vector3.one * math.huge, -Vector3.one * math.huge
	for _, part in parts do
		for _, c in corners(part) do
			lo = Vector3.new(math.min(lo.X, c.X), math.min(lo.Y, c.Y), math.min(lo.Z, c.Z))
			hi = Vector3.new(math.max(hi.X, c.X), math.max(hi.Y, c.Y), math.max(hi.Z, c.Z))
		end
	end
	local c0 = (lo + hi) / 2

	if #npcs == 0 then
		for _, d in workspace:GetDescendants() do
			if d:IsA("Humanoid") and d.Parent and d.Parent:IsA("Model") then
				local root = npcRoot(d.Parent)
				if root then
					local p = root.Position
					if p.X > lo.X - 1 and p.X < hi.X + 1 and p.Z > lo.Z - 1 and p.Z < hi.Z + 1 and p.Y > lo.Y - 2 and p.Y < hi.Y then
						table.insert(npcs, d.Parent)
					end
				end
			end
		end
	end

	-- Which way the stall faces: the way the shopkeeper looks
	local front: Vector3? = nil
	local npc = npcs[1]
	if npc and npc:IsA("Model") then
		local root = npcRoot(npc)
		if root then
			front = flat(root.CFrame.LookVector)
		end
	end

	-- The floor circle: flat, on the ground, in front, and looks like a trigger
	local function padScore(part: BasePart): number
		local ys = corners(part)
		local bottom, top = math.huge, -math.huge
		for _, c in ys do
			bottom = math.min(bottom, c.Y)
			top = math.max(top, c.Y)
		end
		if top - bottom > 1.2 or bottom > lo.Y + 1.5 then
			return 0
		end
		if front and (part.Position - c0):Dot(front) < 0.5 then
			return 0
		end
		local score = 0
		local holder = part.Parent
		for _, d in descendantsAndSelf(part) do
			if d:IsA("ProximityPrompt") or d:IsA("ClickDetector") or d:IsA("Script") or d:IsA("LocalScript") then
				score += 3
				break
			end
		end
		if holder and holder ~= old and holder:FindFirstChildWhichIsA("ProximityPrompt", true) then
			score += 1
		end
		local name = string.lower(part.Name)
		for _, word in PAD_WORDS do
			if string.find(name, word, 1, true) then
				score += 2
				break
			end
		end
		if part:IsA("Part") and part.Shape == Enum.PartType.Cylinder then
			score += 1
		end
		if part:FindFirstChildWhichIsA("SurfaceGui") or part:FindFirstChildWhichIsA("Decal") then
			score += 1
		end
		return score
	end
	local pad: BasePart? = nil
	local best = 0
	for _, part in parts do
		local score = padScore(part)
		if score > best then
			pad, best = part, score
		end
	end
	if not front and pad then
		front = flat(pad.Position - c0)
	end
	if not front and old:IsA("PVInstance") then
		front = flat(old:GetPivot().LookVector)
	end
	local look = front or Vector3.new(0, 0, -1)
	local right = look:Cross(Vector3.yAxis)

	-- Size of the stall itself, leaving out anything flat on the ground in front
	local rMin, rMax, fMin, fMax = math.huge, -math.huge, math.huge, -math.huge
	for _, part in parts do
		local skip = part == pad
		if not skip and pad then
			local size = part.Size
			skip = math.min(size.X, size.Y, size.Z) < 0.6 and (part.Position - pad.Position).Magnitude < 6
		end
		if not skip then
			for _, c in corners(part) do
				local r, f = (c - c0):Dot(right), (c - c0):Dot(look)
				rMin, rMax = math.min(rMin, r), math.max(rMax, r)
				fMin, fMax = math.min(fMin, f), math.max(fMax, f)
			end
		end
	end
	local centre = c0 + right * ((rMin + rMax) / 2) + look * ((fMin + fMax) / 2)
	centre = Vector3.new(centre.X, lo.Y, centre.Z)
	local where = CFrame.lookAt(centre, centre + look)

	local fit: Fit = { width = rMax - rMin, depth = fMax - fMin }

	-- Put the new floor right under the shopkeeper's feet
	if npc then
		local feet = math.huge
		for _, d in npc:GetDescendants() do
			if d:IsA("BasePart") then
				for _, c in corners(d) do
					feet = math.min(feet, c.Y)
				end
			end
		end
		if feet < math.huge then
			fit.floor = math.clamp(feet - lo.Y, 0.2, 3)
		end
	end

	if pad then
		local local_ = where:PointToObjectSpace(pad.Position)
		fit.padX, fit.padZ = local_.X, local_.Z
		local reach = 0
		for _, c in corners(pad) do
			reach = math.max(reach, Vector3.new(c.X - pad.Position.X, 0, c.Z - pad.Position.Z).Magnitude)
		end
		fit.padR = math.clamp(reach / math.sqrt(2), 1.5, 4.5)
	end

	return { cframe = where, fit = fit, npcs = npcs, words = table.concat(words, " "), padFound = pad ~= nil }
end

--------------------------------------------------------------------------
-- Hiding and restoring the old stall
--------------------------------------------------------------------------

local SWITCHABLE = { "SurfaceGui", "BillboardGui", "Light", "Beam", "ParticleEmitter", "Trail", "Highlight", "Fire", "Smoke", "Sparkles" }

local function saveAndSet(inst: Instance, prop: string, value: any)
	if inst:GetAttribute(SAVED .. prop) == nil then
		inst:SetAttribute(SAVED .. prop, (inst :: any)[prop])
	end
	(inst :: any)[prop] = value
end

-- Makes the old stall invisible but keeps it working: its parts can still
-- be touched and its prompts still show. Shopkeepers stay as they are.
local function hideOld(old: Instance, keep: { Instance })
	for _, d in descendantsAndSelf(old) do
		if isInside(d, keep) then
			continue
		end
		if d:IsA("BasePart") then
			saveAndSet(d, "Transparency", 1)
			saveAndSet(d, "CanCollide", false)
		elseif d:IsA("Decal") then
			saveAndSet(d, "Transparency", 1)
		else
			for _, class in SWITCHABLE do
				if d:IsA(class) then
					saveAndSet(d, "Enabled", false)
					break
				end
			end
		end
	end
	old:SetAttribute("PhoneStallsHidden", true)
end

local function restoreOld(old: Instance)
	for _, d in descendantsAndSelf(old) do
		for name, value in d:GetAttributes() do
			if string.sub(name, 1, #SAVED) == SAVED then
				local prop = string.sub(name, #SAVED + 1)
				pcall(function()
					(d :: any)[prop] = value
				end)
				d:SetAttribute(name, nil)
			end
		end
	end
	old:SetAttribute("PhoneStallsHidden", nil)
end

local function linkedOld(model: Instance): Instance?
	local link = model:FindFirstChild("OldStall")
	if link and link:IsA("ObjectValue") then
		return link.Value
	end
	return nil
end

local function newFor(old: Instance): Model?
	for _, d in workspace:GetDescendants() do
		if d:IsA("Model") and d:GetAttribute("PhoneStall") and linkedOld(d) == old then
			return d
		end
	end
	return nil
end

local function waypoint(name: string)
	pcall(function()
		(game:GetService("ChangeHistoryService") :: any):SetWaypoint(name)
	end)
end

local function fitOf(model: Model): Fit
	local function num(name: string): number?
		local v = model:GetAttribute(name)
		return if type(v) == "number" then v else nil
	end
	return {
		width = num("FitWidth"),
		depth = num("FitDepth"),
		floor = num("FitFloor"),
		padX = num("PadX"),
		padZ = num("PadZ"),
		padR = num("PadR"),
	}
end

-- One of ours: build it again in exactly the same place.
local function rebuildOurs(current: Model, stall: Stall): Model
	local model = buildStall(stall, { cframe = current:GetPivot(), fit = fitOf(current), parent = current.Parent })
	local old = linkedOld(current)
	if old then
		make("ObjectValue", { Name = "OldStall", Value = old }, model)
	end
	current:Destroy()
	return model
end

--------------------------------------------------------------------------
-- Shopkeepers
--------------------------------------------------------------------------

-- "me" means whoever is logged in to Studio (or the game's owner).
local function resolveUser(who: any): number?
	if type(who) == "number" and who > 0 then
		return who
	end
	if type(who) == "string" and tonumber(who) then
		return tonumber(who)
	end
	if who == nil or who == true or who == "me" then
		local ok, id = pcall(function()
			return (game:GetService("StudioService") :: any):GetUserId()
		end)
		if ok and type(id) == "number" and id > 0 then
			return id
		end
		if game.CreatorType == Enum.CreatorType.User and game.CreatorId > 0 then
			return game.CreatorId
		end
	end
	return nil
end

local looks: { [string]: Model } = {}

local function avatarLook(userId: number, rig: Enum.HumanoidRigType): (Model?, string?)
	local key = `{userId}:{rig.Name}`
	local cached = looks[key]
	if cached then
		return cached, nil
	end
	local ok, result = pcall(function()
		local description = Players:GetHumanoidDescriptionFromUserId(userId)
		return Players:CreateHumanoidModelFromDescription(description, rig)
	end)
	if not ok then
		return nil, tostring(result)
	end
	looks[key] = result
	return result, nil
end

local function bodyPart(model: Model, name: string): BasePart?
	local p = model:FindFirstChild(name)
	if p and p:IsA("BasePart") then
		return p
	end
	return nil
end

-- The body part an accessory hangs off.
local function wornOn(handle: BasePart): BasePart?
	for _, j in handle:GetChildren() do
		if j:IsA("JointInstance") or j:IsA("WeldConstraint") then
			local joint = j :: any
			local other = if joint.Part0 == handle then joint.Part1 else joint.Part0
			if other and other:IsA("BasePart") then
				return other
			end
		end
	end
	return nil
end

local function isOutfit(c: Instance): boolean
	return c:IsA("Accessory") or c:IsA("Clothing") or c:IsA("ShirtGraphic") or c:IsA("BodyColors") or c:IsA("CharacterMesh")
end

local function colorKey(partName: string): string
	return "Color_" .. string.gsub(partName, "%W", "_")
end

local function faceOf(head: BasePart?): Decal?
	if not head then
		return nil
	end
	for _, d in head:GetChildren() do
		if d:IsA("Decal") and d.Name == "face" then
			return d
		end
	end
	return nil
end

-- The shopkeeper's own outfit, kept in ServerStorage > PhoneStallsLooks
-- while they wear an avatar, so it can be put back.
local function savedLook(npc: Model, create: boolean): Folder?
	local root = ServerStorage:FindFirstChild("PhoneStallsLooks")
	local id = npc:GetAttribute("PhoneStallsLook")
	if type(id) == "string" and root then
		local existing = root:FindFirstChild(id)
		if existing and existing:IsA("Folder") then
			return existing
		end
	end
	if not create then
		return nil
	end
	if not root then
		root = make("Folder", { Name = "PhoneStallsLooks" }, ServerStorage)
	end
	local newId = HttpService:GenerateGUID(false)
	npc:SetAttribute("PhoneStallsLook", newId)
	local store: Folder = make("Folder", { Name = newId }, root)
	store:SetAttribute("Shopkeeper", npc:GetFullName())
	for _, c in npc:GetChildren() do
		if isOutfit(c) then
			c.Parent = store
		elseif c:IsA("BasePart") then
			store:SetAttribute(colorKey(c.Name), c.Color)
		end
	end
	local face = faceOf(bodyPart(npc, "Head"))
	if face then
		face.Parent = make("Folder", { Name = "Face" }, store)
	end
	return store
end

local function markAvatar(inst: Instance): Instance
	inst:SetAttribute("PhoneStallsAvatar", true)
	return inst
end

-- Puts the avatar's clothes, hair and hats, face and skin colour on the
-- shopkeeper. Its body, position and any scripts stay as they are, and its
-- own outfit is kept so UndressShopkeepers can put it back.
local function dress(npc: Model, look: Model)
	local store = savedLook(npc, true)
	for _, c in npc:GetChildren() do
		if isOutfit(c) then
			c:Destroy()
		end
	end
	for _, c in look:GetChildren() do
		if c:IsA("Clothing") or c:IsA("ShirtGraphic") or c:IsA("BodyColors") then
			markAvatar(c:Clone()).Parent = npc
		elseif c:IsA("BasePart") and c.Name ~= "HumanoidRootPart" then
			local mine = bodyPart(npc, c.Name)
			if mine then
				mine.Color = c.Color
			end
		end
	end

	local head, lookHead = bodyPart(npc, "Head"), bodyPart(look, "Head")
	if head then
		local old = faceOf(head)
		if old then
			old:Destroy()
		end
		local face = faceOf(lookHead)
		local ownFace = store and store:FindFirstChild("Face")
		local fallback = if ownFace then ownFace:FindFirstChildOfClass("Decal") else nil
		local use = face or fallback
		if use then
			markAvatar(use:Clone()).Parent = head
		end
	end
	for _, accessory in look:GetChildren() do
		local handle = if accessory:IsA("Accessory") then accessory:FindFirstChild("Handle") else nil
		if handle and handle:IsA("BasePart") then
			local theirs = wornOn(handle) or lookHead
			local mine = if theirs then bodyPart(npc, theirs.Name) or head else head
			if theirs and mine then
				local copy = accessory:Clone()
				local h = copy:FindFirstChild("Handle") :: BasePart
				for _, j in h:GetChildren() do
					if j:IsA("JointInstance") or j:IsA("WeldConstraint") then
						j:Destroy()
					end
				end
				h.CFrame = mine.CFrame * theirs.CFrame:ToObjectSpace(handle.CFrame)
				h.Anchored = false
				h.CanCollide = false
				h.CanTouch = false
				h.CanQuery = false
				h.Massless = true
				make("WeldConstraint", { Name = "AccessoryWeld", Part0 = mine, Part1 = h }, h)
				markAvatar(copy).Parent = npc
			end
		end
	end
end

local partialUndress = false

-- Takes the avatar off and gives the shopkeeper their own outfit back.
-- Returns true if there was an avatar to take off. The first PhoneStalls
-- didn't keep the old outfit; its avatar hats are only recognised on
-- shopkeepers it already tagged.
local function undress(npc: Model): boolean
	local store = savedLook(npc, false)
	local fromFirstVersion = false
	local tagged = CollectionService:HasTag(npc, "StallShopkeeper")
	local worn: { Instance } = if tagged then npc:GetChildren() else {}
	for _, c in worn do
		local handle = if c:IsA("Accessory") then c:FindFirstChild("Handle") else nil
		local weld = if handle then handle:FindFirstChild("AccessoryWeld") else nil
		if weld and weld:IsA("WeldConstraint") then
			fromFirstVersion = true
		end
	end
	if not store and not fromFirstVersion and not npc:GetAttribute("PhoneStallsDressed") then
		return false
	end

	for _, c in npc:GetChildren() do
		if isOutfit(c) then
			c:Destroy()
		end
	end
	local head = bodyPart(npc, "Head")
	local face = faceOf(head)
	if face then
		face:Destroy()
	end

	if store then
		for _, c in store:GetChildren() do
			if c.Name == "Face" and c:IsA("Folder") then
				local own = c:FindFirstChildOfClass("Decal")
				if own and head then
					own.Parent = head
				end
			else
				c.Parent = npc
			end
		end
		for _, part in npc:GetChildren() do
			if part:IsA("BasePart") then
				local color = store:GetAttribute(colorKey(part.Name))
				if typeof(color) == "Color3" then
					part.Color = color
				end
			end
		end
		store:Destroy()
	else
		partialUndress = true
		if head then
			make("Decal", { Name = "face", Face = Enum.NormalId.Front, Texture = "rbxasset://textures/face.png" }, head)
		end
	end
	npc:SetAttribute("PhoneStallsLook", nil)
	npc:SetAttribute("PhoneStallsDressed", nil)
	return true
end

-- Shopkeepers standing inside one of our stalls.
local function shopkeepersIn(stall: Model): { Instance }
	local fit = fitOf(stall)
	local hw, hd = (fit.width or 14) / 2 + 0.5, (fit.depth or 9) / 2 + 0.5
	local pivot = stall:GetPivot()
	local found: { Instance } = {}
	for _, h in workspace:GetDescendants() do
		local npc = h.Parent
		if h:IsA("Humanoid") and npc and npc:IsA("Model") and not npc:IsDescendantOf(stall) then
			local root = npcRoot(npc)
			if root then
				local p = pivot:PointToObjectSpace(root.Position)
				if math.abs(p.X) < hw and math.abs(p.Z) < hd and p.Y > -2 and p.Y < 12 then
					table.insert(found, npc)
				end
			end
		end
	end
	return found
end

local warnedNoUser = false

-- Tags the shopkeepers for StallFX and dresses them. Returns how many were dressed.
local function prepareShopkeepers(npcs: { Instance }, s: Stall): number
	local dressed = 0
	for _, npc in npcs do
		if not npc:IsA("Model") then
			continue
		end
		if s.Shopkeeper == nil or s.Shopkeeper == false then
			undress(npc)
		end
		npc:SetAttribute("ShopkeeperMoves", s.ShopkeeperMoves ~= false)
		CollectionService:AddTag(npc, "StallShopkeeper")
		if s.Shopkeeper == nil or s.Shopkeeper == false then
			continue
		end
		local userId = resolveUser(s.Shopkeeper)
		local humanoid = npc:FindFirstChildOfClass("Humanoid")
		if not userId then
			if not warnedNoUser then
				warnedNoUser = true
				warn("[PhoneStalls] I couldn't tell whose avatar to use. In StallConfig, set Shopkeeper to your UserId (the number in your Roblox profile link).")
			end
		elseif humanoid then
			local look, problem = avatarLook(userId, humanoid.RigType)
			if look then
				dress(npc, look)
				npc:SetAttribute("PhoneStallsDressed", true)
				dressed += 1
			else
				warn(`[PhoneStalls] Couldn't load the avatar for user {userId}: {problem}`)
			end
		end
	end
	return dressed
end

--------------------------------------------------------------------------
-- Public
--------------------------------------------------------------------------

-- Builds one stall. With no options it stands at the world centre.
function PhoneStalls.Build(name: string, options: BuildOptions?): Model
	local stalls = loadConfig()
	local s = findStall(stalls, name)
	if not s then
		error(`[PhoneStalls] No stall called "{name}" in StallConfig. Try one of: {stallNames(stalls)}`)
	end
	return buildStall(s, options)
end

-- Gives the selected stall its new look. `width` (studs) is optional.
function PhoneStalls.ReplaceSelected(name: string?, width: number?): Model?
	local Selection = game:GetService("Selection") :: any
	local picked: Instance? = Selection:Get()[1]
	if not picked then
		warn("[PhoneStalls] Click your old stall first so it is selected, then run the line again.")
		return nil
	end
	local old = topModel(picked)
	local stalls = loadConfig()

	local ours = old:GetAttribute("PhoneStall")
	if type(ours) == "string" and old:IsA("Model") then
		local s = findStall(stalls, name or ours)
		if not s then
			warn(`[PhoneStalls] No stall called "{name or ours}" in StallConfig. Try one of: {stallNames(stalls)}`)
			return nil
		end
		waypoint("Before PhoneStalls")
		table.clear(looks)
		local model = rebuildOurs(old, s)
		prepareShopkeepers(shopkeepersIn(model), s)
		waypoint("PhoneStalls")
		Selection:Set({ model })
		return model
	end
	if old:GetAttribute("PhoneStallsHidden") then
		warn(`[PhoneStalls] "{old.Name}" already has its new look. Select the new stall instead, or run Restore() to undo it.`)
		return nil
	end

	local a = analyse(old)
	if not a then
		warn(`[PhoneStalls] "{old.Name}" has no visible parts to measure. Select the whole stall.`)
		return nil
	end
	local s = if name then findStall(stalls, name) else findStall(stalls, a.words)
	if not s then
		warn(`[PhoneStalls] Is "{old.Name}" the buy or the sell stall? Run it again with the name, one of: {stallNames(stalls)}`)
		return nil
	end
	if width then
		a.fit.width = width
	end

	waypoint("Before PhoneStalls")
	local model = buildStall(s, { cframe = a.cframe, fit = a.fit, parent = old.Parent })
	make("ObjectValue", { Name = "OldStall", Value = old }, model)
	hideOld(old, a.npcs)
	table.clear(looks)
	local dressed = prepareShopkeepers(a.npcs, s)
	waypoint("PhoneStalls")
	Selection:Set({ model })

	local note = if a.padFound then "The floor circle is on top of your old one." else "I couldn't find your old floor circle, so the new one is in front of the counter."
	local keeper = if dressed > 0 then " The shopkeeper is wearing your avatar." elseif #a.npcs == 0 then " I didn't find a shopkeeper in this stall." else ""
	print(`[PhoneStalls] Built "{model.Name}". The old stall is hidden but still works. {note}{keeper}`)
	return model
end

-- Puts the selected stall back the way it was.
function PhoneStalls.Restore(): boolean
	local Selection = game:GetService("Selection") :: any
	local picked: Instance? = Selection:Get()[1]
	if not picked then
		warn("[PhoneStalls] Click the stall first so it is selected, then run the line again.")
		return false
	end
	local top = topModel(picked)
	local ours: Model? = if top:IsA("Model") and top:GetAttribute("PhoneStall") then top else newFor(top)
	local old = if ours then linkedOld(ours) else top
	waypoint("Before PhoneStalls restore")
	if old then
		restoreOld(old)
	end
	if ours then
		ours:Destroy()
	end
	waypoint("PhoneStalls restore")
	if old then
		Selection:Set({ old })
	end
	print("[PhoneStalls] Put the old stall back.")
	return true
end

-- Rebuilds every stall this module made, where it stands. Use it after
-- changing StallConfig or putting in a newer PhoneStalls.
function PhoneStalls.Rebuild(): { Model }
	local stalls = loadConfig()
	local found: { Model } = {}
	for _, d in workspace:GetDescendants() do
		if d:IsA("Model") and type(d:GetAttribute("PhoneStall")) == "string" then
			table.insert(found, d)
		end
	end
	waypoint("Before PhoneStalls rebuild")
	table.clear(looks)
	local models = {}
	for _, current in found do
		local name = current:GetAttribute("PhoneStall") :: string
		local s = findStall(stalls, name)
		if s then
			local model = rebuildOurs(current, s)
			prepareShopkeepers(shopkeepersIn(model), s)
			table.insert(models, model)
		else
			warn(`[PhoneStalls] Skipped "{name}": it is not in StallConfig any more.`)
		end
	end
	waypoint("PhoneStalls rebuild")
	print(`[PhoneStalls] Rebuilt {#models} stall(s).`)
	return models
end

-- Dresses the shopkeepers in every stall. `who` is "me" (default) or a UserId.
function PhoneStalls.DressShopkeepers(who: any?): number
	local stalls = loadConfig()
	table.clear(looks)
	warnedNoUser = false
	local count = 0
	waypoint("Before PhoneStalls dress")
	for _, d in workspace:GetDescendants() do
		local name = d:GetAttribute("PhoneStall")
		if d:IsA("Model") and type(name) == "string" then
			local s: Stall = table.clone(findStall(stalls, name) or {})
			s.Shopkeeper = if who ~= nil then who elseif s.Shopkeeper == false or s.Shopkeeper == nil then "me" else s.Shopkeeper
			count += prepareShopkeepers(shopkeepersIn(d), s)
		end
	end
	waypoint("PhoneStalls dress")
	print(`[PhoneStalls] Dressed {count} shopkeeper(s).`)
	return count
end

-- Takes the avatar off every shopkeeper and gives them their own look back.
function PhoneStalls.UndressShopkeepers(): number
	partialUndress = false
	local npcs: { Instance } = CollectionService:GetTagged("StallShopkeeper")
	for _, d in workspace:GetDescendants() do
		if d:IsA("Model") and type(d:GetAttribute("PhoneStall")) == "string" then
			for _, npc in shopkeepersIn(d) do
				table.insert(npcs, npc)
			end
		end
	end
	waypoint("Before PhoneStalls undress")
	local seen: { [Instance]: boolean } = {}
	local count = 0
	for _, npc in npcs do
		if npc:IsA("Model") and not seen[npc] then
			seen[npc] = true
			if undress(npc) then
				count += 1
			end
		end
	end
	waypoint("PhoneStalls undress")
	print(`[PhoneStalls] Took the avatar off {count} shopkeeper(s).`)
	if partialUndress then
		warn("[PhoneStalls] The first version of PhoneStalls didn't keep the shopkeepers' own clothes, so they now have a plain look. If you dressed them in this Studio session, Ctrl+Z gets their old clothes back instead.")
	end
	return count
end

return PhoneStalls
]]></string>
    </Properties>
    <Item class="ModuleScript" referent="1">
      <Properties>
        <string name="Name">StallConfig</string>
        <string name="Source"><![CDATA[--[[
	StallConfig  (ModuleScript, child of PhoneStalls)

	One entry per stall. Change the words and colours here, then run
	require(game.ServerStorage.PhoneStalls).Rebuild() in the Command Bar.

	Colours are { red, green, blue } from 0 to 255.
]]

return {
	{
		Name = "Buy Stall", -- what the new model is called in the Explorer
		Sign = "BUY", -- the big neon letters on the roof
		Kind = "buy", -- "buy" or "sell": changes what sits on the counter and shelves
		Accent = { 40, 220, 255 }, -- neon colour
		Icon = "bag", -- "bag", "cash", "phone" or "none": on the counter and above the floor circle
		Menu = { "FRESH PHONES", "Grown on the farm today", "Step on the circle to buy" },
		OpenSign = true, -- the little neon OPEN sign
		Plants = true, -- potted plants by the front corners
		StringLights = true, -- warm bulbs hanging from the roof edge
		Ticker = "NEW PHONES EVERY DAY  *  BEST PRICES IN TOWN  *  COME ON IN  *", -- scrolling LED text on the roof edge
		Poster = { "NEW PHONES", "Fresh from the farm every day", "HOT" }, -- the lit posters on both sides
		Board = { "OPEN", "Phones in stock", "Come on in!" }, -- the chalkboard out front

		-- Who the shopkeeper looks like: false keeps their own look, "me" is
		-- your Roblox avatar, or a UserId (the number in a profile link).
		Shopkeeper = false,
		ShopkeeperMoves = true, -- idles and waves when someone walks up
	},
	{
		Name = "Sell Stall",
		Sign = "SELL",
		Kind = "sell",
		Accent = { 255, 45, 60 },
		Icon = "cash",
		Menu = { "WE BUY PHONES", "Instant cash for any phone", "Step on the circle to sell" },
		OpenSign = true,
		Plants = true,
		StringLights = true,
		Ticker = "WE BUY PHONES  *  INSTANT CASH  *  ANY PHONE, ANY SIZE  *",
		Poster = { "CASH FOR PHONES", "Any phone, paid on the spot", "FAST" },
		Board = { "OPEN", "We buy phones", "Come on in!" },
		Shopkeeper = false,
		ShopkeeperMoves = true,
	},
}
]]></string>
      </Properties>
    </Item>
    <Item class="LocalScript" referent="2">
      <Properties>
        <string name="Name">StallFX</string>
        <string name="Source"><![CDATA[--!strict
--[[
	StallFX  (LocalScript in StarterPlayerScripts; PhoneStalls puts it there)

	Animates the stalls on each player's screen:
	  * the icons above the floor circles spin and float up and down
	  * the display phone on the BUY counter turns on its turntable
	  * the glow round the floor circles fades in and out, and lights up
	    while you stand on the circle
	  * the neon signs flicker now and then, like real neon
	  * the LED ticker on the roof edge scrolls
	  * the shopkeepers stand idle and wave when you walk up
]]

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local WAVE_DISTANCE = 16 -- studs from the shopkeeper
local WAVE_EVERY = 10 -- seconds before the same shopkeeper waves again
local TICKER_SPEED = 90 -- pixels per second
local ANIMATIONS = {
	R15 = { idle = "rbxassetid://507766666", wave = "rbxassetid://507770239" },
	R6 = { idle = "rbxassetid://180435571", wave = "rbxassetid://128777973" },
}

type Spinner = { base: CFrame, speed: number, bob: number, phase: number }

local spinners: { [Model]: Spinner } = {}
local breathers: { [Model]: { low: number, high: number, radius: number, boost: number } } = {}
local flickering: { [Model]: number } = {} -- next time each sign flickers
local tickers: { [BasePart]: boolean } = {}
type Keeper = { root: BasePart, wave: AnimationTrack?, lastWave: number, near: boolean }
local keepers: { [Model]: Keeper } = {}

local function number(inst: Instance, name: string, default: number): number
	local v = inst:GetAttribute(name)
	return if type(v) == "number" then v else default
end

local function watch(tag: string, added: (Model) -> (), removed: (Model) -> ())
	for _, inst in CollectionService:GetTagged(tag) do
		if inst:IsA("Model") then
			added(inst)
		end
	end
	CollectionService:GetInstanceAddedSignal(tag):Connect(function(inst)
		if inst:IsA("Model") then
			added(inst)
		end
	end)
	CollectionService:GetInstanceRemovedSignal(tag):Connect(function(inst)
		if inst:IsA("Model") then
			removed(inst)
		end
	end)
end

watch("StallSpin", function(m)
	spinners[m] = { base = m:GetPivot(), speed = number(m, "Speed", 1), bob = number(m, "Bob", 0), phase = math.random() * 6 }
end, function(m)
	spinners[m] = nil
end)

watch("StallBreathe", function(m)
	breathers[m] = { low = number(m, "Low", 0.7), high = number(m, "High", 0.9), radius = number(m, "Radius", 0), boost = 0 }
end, function(m)
	breathers[m] = nil
end)

watch("StallFlicker", function(m)
	flickering[m] = os.clock() + 3 + math.random() * 10
end, function(m)
	flickering[m] = nil
end)

local function playerRoot(): BasePart?
	local character = Players.LocalPlayer.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	return if root and root:IsA("BasePart") then root else nil
end

-- Shopkeepers: a gentle idle, and a wave when someone walks up
local function loadTrack(animator: Animator, id: string, looped: boolean, priority: Enum.AnimationPriority): AnimationTrack?
	local animation = Instance.new("Animation")
	animation.AnimationId = id
	local ok, track = pcall(function()
		return animator:LoadAnimation(animation)
	end)
	if not ok or not track then
		return nil
	end
	track.Looped = looped
	track.Priority = priority
	return track
end

watch("StallShopkeeper", function(m)
	if m:GetAttribute("ShopkeeperMoves") == false then
		return
	end
	local humanoid = m:FindFirstChildOfClass("Humanoid")
	local root = if humanoid then humanoid.RootPart or m:FindFirstChild("HumanoidRootPart") else nil
	if not humanoid or not root or not root:IsA("BasePart") then
		return
	end
	local found = humanoid:FindFirstChildOfClass("Animator")
	local animator: Animator
	if found then
		animator = found
	else
		animator = Instance.new("Animator")
		animator.Parent = humanoid
	end
	local ids = if humanoid.RigType == Enum.HumanoidRigType.R15 then ANIMATIONS.R15 else ANIMATIONS.R6
	local idle = loadTrack(animator, ids.idle, true, Enum.AnimationPriority.Idle)
	if idle then
		idle:Play()
	end
	keepers[m] = { root = root, wave = loadTrack(animator, ids.wave, false, Enum.AnimationPriority.Action), lastWave = 0, near = false }
end, function(m)
	keepers[m] = nil
end)

-- LED tickers on the roof edge
local function addTicker(inst: Instance)
	if inst:IsA("BasePart") then
		tickers[inst] = true
	end
end
for _, inst in CollectionService:GetTagged("StallTicker") do
	addTicker(inst)
end
CollectionService:GetInstanceAddedSignal("StallTicker"):Connect(addTicker)
CollectionService:GetInstanceRemovedSignal("StallTicker"):Connect(function(inst)
	if inst:IsA("BasePart") then
		tickers[inst] = nil
	end
end)

local function scrollTicker(part: BasePart, t: number)
	local gui = part:FindFirstChild("Screen")
	local track = gui and gui:FindFirstChild("Track")
	local a = track and track:FindFirstChild("A")
	local b = track and track:FindFirstChild("B")
	if not a or not b or not a:IsA("GuiObject") or not b:IsA("GuiObject") then
		return
	end
	local width = a.AbsoluteSize.X
	if width <= 0 then
		return
	end
	local shift = (t * TICKER_SPEED) % width
	a.Position = UDim2.fromOffset(-shift, 0)
	b.Position = UDim2.fromOffset(width - shift, 0)
end

-- Switches a sign's neon and screens off or back on.
local saved: { [BasePart]: number } = setmetatable({}, { __mode = "k" }) :: any
local function setSign(m: Model, on: boolean)
	for _, d in m:GetDescendants() do
		if d:IsA("SurfaceGui") then
			d.Enabled = on
		elseif d:IsA("BasePart") and d.Material == Enum.Material.Neon then
			if saved[d] == nil then
				saved[d] = d.Transparency
			end
			d.Transparency = if on then saved[d] else 0.85
		elseif d:IsA("Light") then
			d.Enabled = on
		end
	end
end

local function flicker(m: Model)
	task.spawn(function()
		for _ = 1, math.random(2, 4) do
			setSign(m, false)
			task.wait(0.03 + math.random() * 0.09)
			setSign(m, true)
			task.wait(0.04 + math.random() * 0.2)
		end
	end)
end

RunService.RenderStepped:Connect(function(dt: number)
	local t = os.clock()
	local me = playerRoot()
	for m, s in spinners do
		if m.Parent then
			local lift = s.bob * math.sin(t * 1.6 + s.phase)
			m:PivotTo(s.base * CFrame.new(0, lift, 0) * CFrame.Angles(0, t * s.speed + s.phase, 0))
		end
	end
	for m, b in breathers do
		-- brighter, faster glow while you stand on the circle
		local inside = false
		if me and b.radius > 0 then
			local centre = m:GetPivot().Position
			inside = Vector3.new(me.Position.X - centre.X, 0, me.Position.Z - centre.Z).Magnitude < b.radius
		end
		b.boost += ((if inside then 1 else 0) - b.boost) * math.min(1, dt * 6)
		local wave = 0.5 + 0.5 * math.sin(t * (2.2 + b.boost * 4))
		local transparency = b.low + (b.high - b.low) * wave - b.boost * 0.35
		for _, d in m:GetDescendants() do
			if d:IsA("BasePart") then
				d.Transparency = transparency
			end
		end
	end
	for m, nextTime in flickering do
		if t >= nextTime then
			flickering[m] = t + 6 + math.random() * 12
			flicker(m)
		end
	end
	for part in tickers do
		scrollTicker(part, t)
	end
	for _, k in keepers do
		local near = me ~= nil and (me.Position - k.root.Position).Magnitude < WAVE_DISTANCE
		if near and not k.near and t - k.lastWave > WAVE_EVERY and k.wave then
			k.lastWave = t
			k.wave:Play()
		end
		k.near = near
	end
end)
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="3">
      <Properties>
        <string name="Name">StallGeometry</string>
        <string name="Source"><![CDATA[--!strict
--[[
	StallGeometry  (ModuleScript, child of PhoneStalls)

	Pure math: describes one market stall as simple shapes (boxes,
	cylinders and balls) plus the screens, signs and lights on them.
	PhoneStalls turns that list into Roblox parts.

	The stall stands on y = 0, is centred on x = 0, z = 0 and its counter
	faces -Z, so the model's LookVector points at the customers. Heights
	are fixed for a normal-sized character; width and depth stretch to fit.
]]

export type RGB = { number }
export type Vec = { number }
export type Mat = { number } -- 3x3 rotation, row by row

export type Light = {
	kind: string, -- "spot" or "point"
	color: RGB,
	brightness: number,
	range: number,
	angle: number, -- spot lights only, in degrees
	face: string, -- spot lights shine out of this face of their part
}

export type Gui = {
	kind: string, -- "sign", "open", "menu", "icon", "token", "screen" or "display"
	face: string, -- "Front" or "Top"
	twoSided: boolean, -- also draw it on the opposite face
	text: string,
	lines: { string },
	icon: string,
	color: RGB, -- the stall's neon colour
}

export type Prim = {
	kind: string, -- "box", "cyl" (round ends on its own X axis) or "ball"
	name: string,
	group: string, -- folder inside the model, or a moving group (see Motion)
	size: Vec,
	pos: Vec,
	rot: Mat,
	color: RGB,
	material: string,
	reflectance: number,
	transparency: number,
	solid: boolean, -- players bump into it
	shadow: boolean,
	light: Light?,
	gui: Gui?,
	tag: string?, -- CollectionService tag for StallFX, e.g. "StallTicker"
	sparkles: RGB?, -- floating sparkles in this colour
}

export type Motion = {
	group: string,
	fx: string, -- "spin" (turns and bobs), "flicker" (neon sign blinks now and then) or "breathe" (glow fades in and out)
	pivot: Vec,
	speed: number, -- spin: radians per second
	bob: number, -- spin: studs up and down
	low: number, -- breathe: transparency range
	high: number,
	radius: number, -- breathe: glows brighter while the player stands inside this radius
}

export type Stall = { -- one entry in StallConfig
	Name: string?,
	Sign: string?,
	Kind: string?,
	Accent: RGB?,
	Icon: string?,
	Menu: { string }?,
	OpenSign: boolean?,
	Plants: boolean?,
	Ticker: string?, -- scrolling LED text along the roof edge
	Poster: { string }?, -- headline and line on the lit posters on both sides
	Board: { string }?, -- chalkboard sign out front, one entry per line
	StringLights: boolean?, -- warm bulbs hanging from the roof edge
	Shopkeeper: any?, -- "me", a UserId, or false (PhoneStalls dresses the shopkeeper)
	ShopkeeperMoves: boolean?, -- shopkeeper idles and waves (StallFX)
}

export type Fit = {
	width: number?, -- along the counter
	depth: number?,
	floor: number?, -- height of the floor the shopkeeper stands on
	padX: number?, -- where the floor circle goes (stall space)
	padZ: number?,
	padR: number?,
}

export type Result = { prims: { Prim }, motions: { Motion }, width: number, depth: number }

local StallGeometry = {}

--------------------------------------------------------------------------
-- Tiny 3D math
--------------------------------------------------------------------------

local IDENTITY: Mat = { 1, 0, 0, 0, 1, 0, 0, 0, 1 }

local function rotX(deg: number): Mat
	local c, s = math.cos(math.rad(deg)), math.sin(math.rad(deg))
	return { 1, 0, 0, 0, c, -s, 0, s, c }
end

local function rotY(deg: number): Mat
	local c, s = math.cos(math.rad(deg)), math.sin(math.rad(deg))
	return { c, 0, s, 0, 1, 0, -s, 0, c }
end

local function rotZ(deg: number): Mat
	local c, s = math.cos(math.rad(deg)), math.sin(math.rad(deg))
	return { c, -s, 0, s, c, 0, 0, 0, 1 }
end

local function mix(a: RGB, b: RGB, t: number): RGB
	return {
		math.floor(a[1] + (b[1] - a[1]) * t + 0.5),
		math.floor(a[2] + (b[2] - a[2]) * t + 0.5),
		math.floor(a[3] + (b[3] - a[3]) * t + 0.5),
	}
end

local WHITE: RGB = { 255, 255, 255 }
local BLACK: RGB = { 0, 0, 0 }

--------------------------------------------------------------------------
-- Shape helpers
--------------------------------------------------------------------------

type Props = {
	color: RGB,
	material: string?,
	reflectance: number?,
	transparency: number?,
	solid: boolean?,
	shadow: boolean?,
	light: Light?,
	gui: Gui?,
	tag: string?,
	sparkles: RGB?,
}

type Ctx = { prims: { Prim }, group: string }

local function add(ctx: Ctx, kind: string, name: string, size: Vec, pos: Vec, rot: Mat, p: Props)
	table.insert(ctx.prims, {
		kind = kind,
		name = name,
		group = ctx.group,
		size = size,
		pos = pos,
		rot = rot,
		color = p.color,
		material = p.material or "SmoothPlastic",
		reflectance = p.reflectance or 0,
		transparency = p.transparency or 0,
		solid = if p.solid == nil then true else p.solid,
		shadow = if p.shadow == nil then true else p.shadow,
		light = p.light,
		gui = p.gui,
		tag = p.tag,
		sparkles = p.sparkles,
	})
end

local function box(ctx: Ctx, name: string, size: Vec, pos: Vec, p: Props)
	add(ctx, "box", name, size, pos, IDENTITY, p)
end

-- Upright cylinder (round ends facing up and down).
local function post(ctx: Ctx, name: string, radius: number, height: number, pos: Vec, p: Props)
	add(ctx, "cyl", name, { height, radius * 2, radius * 2 }, pos, rotZ(90), p)
end

-- Cylinder with its round ends facing front and back.
local function disc(ctx: Ctx, name: string, radius: number, thick: number, pos: Vec, p: Props)
	add(ctx, "cyl", name, { thick, radius * 2, radius * 2 }, pos, rotY(90), p)
end

local function ball(ctx: Ctx, name: string, radius: number, pos: Vec, p: Props)
	add(ctx, "ball", name, { radius * 2, radius * 2, radius * 2 }, pos, IDENTITY, p)
end

local function neon(color: RGB, transparency: number?): Props
	return { color = color, material = "Neon", solid = false, shadow = false, transparency = transparency }
end

local function deco(color: RGB, material: string?): Props
	return { color = color, material = material, solid = false }
end

type GuiExtra = { text: string?, lines: { string }?, icon: string?, face: string?, twoSided: boolean? }

local function gui(kind: string, accent: RGB, extra: GuiExtra?): Gui
	local e: GuiExtra = extra or {}
	return {
		kind = kind,
		face = e.face or "Front",
		twoSided = e.twoSided or false,
		text = e.text or "",
		lines = e.lines or {},
		icon = e.icon or "none",
		color = accent,
	}
end

--------------------------------------------------------------------------
-- Palette
--------------------------------------------------------------------------

local BODY: RGB = { 22, 23, 27 }
local FRAME: Props = { color = { 42, 44, 50 }, material = "Metal" }
local STONE: Props = { color = { 36, 36, 40 }, material = "Slate" }
local MARBLE: Props = { color = { 234, 233, 230 }, material = "Marble", reflectance = 0.05 }
local WOOD: RGB = { 128, 92, 62 }
local WARM: RGB = { 255, 228, 190 }

local BOX_COLORS: { RGB } = {
	{ 240, 240, 236 },
	{ 30, 30, 34 },
	{ 214, 186, 140 },
	{ 190, 200, 214 },
	{ 236, 170, 190 },
	{ 170, 214, 196 },
}

--------------------------------------------------------------------------
-- The stall
--------------------------------------------------------------------------

function StallGeometry.Shapes(s: Stall, fit: Fit?): Result
	local f: Fit = fit or {}
	local W = math.clamp(f.width or 14, 9, 30)
	local D = math.clamp(f.depth or 9, 6, 16)
	local FL = math.clamp(f.floor or 0.6, 0.2, 3)
	local accent = s.Accent or { 40, 220, 255 }
	local kind = string.lower(s.Kind or "buy")
	local icon = s.Icon or (if kind == "sell" then "cash" else "bag")
	local text = s.Sign or string.upper(kind)

	local CT = FL + 3.4 -- counter top
	local RH = FL + 9.4 -- underside of the roof
	local front, back = -D / 2, D / 2
	local zc = front + 0.7 -- front face of the counter
	local CD = 1.5 -- counter depth

	local ctx: Ctx = { prims = {}, group = "Base" }
	local motions: { Motion } = {}
	local function motion(group: string, fx: string, pivot: Vec, speed: number, bob: number, low: number, high: number, radius: number?)
		table.insert(motions, { group = group, fx = fx, pivot = pivot, speed = speed, bob = bob, low = low, high = high, radius = radius or 0 })
	end

	------------------------------------------------------------------ base
	box(ctx, "Base", { W, FL, D }, { 0, FL / 2, 0 }, STONE)
	box(ctx, "BaseTrim", { W + 0.02, 0.14, 0.06 }, { 0, FL - 0.07, front - 0.02 }, { color = { 130, 132, 138 }, material = "Metal" })
	box(ctx, "Underglow", { W - 0.6, 0.12, 0.12 }, { 0, 0.12, front - 0.04 }, {
		color = accent,
		material = "Neon",
		solid = false,
		shadow = false,
		light = { kind = "spot", color = accent, brightness = 1.2, range = 10, angle = 120, face = "Front" },
	})
	for _, sx in { -1, 1 } do
		box(ctx, "Underglow", { 0.12, 0.12, D - 0.6 }, { sx * (W / 2 + 0.04), 0.12, 0 }, neon(accent))
	end
	box(ctx, "Floor", { W - 1, 0.08, D - 1 }, { 0, FL + 0.04, 0 }, { color = { 78, 58, 44 }, material = "WoodPlanks" })

	------------------------------------------------------------------ counter
	ctx.group = "Counter"
	local bodyH = CT - 0.3 - FL
	local cw = W - 1.8
	box(ctx, "Counter", { cw, bodyH, CD }, { 0, FL + bodyH / 2, zc + CD / 2 }, { color = BODY })
	box(ctx, "CounterTop", { W - 1.5, 0.3, CD + 0.7 }, { 0, CT - 0.15, zc + CD / 2 - 0.3 }, MARBLE)
	box(ctx, "CounterGlow", { W - 1.7, 0.08, 0.08 }, { 0, CT - 0.36, zc - 0.5 }, neon(accent))
	box(ctx, "KickPlate", { cw, 0.2, 0.08 }, { 0, FL + 0.1, zc - 0.04 }, { color = { 90, 92, 98 }, material = "Metal" })

	-- Fluted metal front, with a lit panel in the middle
	local fluteH = bodyH - 0.45
	local fluteY = FL + 0.25 + fluteH / 2
	local x = -cw / 2 + 0.3
	while x <= cw / 2 - 0.29 do
		if math.abs(x) > 2.05 then
			post(ctx, "Flute", 0.16, fluteH, { x, fluteY, zc - 0.06 }, { color = { 48, 50, 56 }, material = "Metal" })
		end
		x += 0.42
	end
	box(ctx, "Lightbox", { 3.6, math.min(2, fluteH), 0.16 }, { 0, fluteY, zc - 0.08 }, {
		color = { 14, 15, 18 },
		gui = gui("icon", accent, { icon = icon }),
	})

	------------------------------------------------------------------ frame and walls
	ctx.group = "Frame"
	for _, sx in { -1, 1 } do
		for _, sz in { -1, 1 } do
			box(ctx, "Pillar", { 0.8, RH - FL, 0.8 }, { sx * (W / 2 - 0.4), FL + (RH - FL) / 2, sz * (D / 2 - 0.4) }, FRAME)
		end
		box(ctx, "PillarGlow", { 0.12, RH - FL - 0.6, 0.12 }, { sx * (W / 2 - 0.76), FL + (RH - FL) / 2, front - 0.02 }, neon(accent))
		box(ctx, "SideWall", { 0.25, CT - FL, D - 1.6 }, { sx * (W / 2 - 0.4), FL + (CT - FL) / 2, 0 }, { color = BODY })
		box(ctx, "SideRail", { 0.3, 0.15, D - 1.6 }, { sx * (W / 2 - 0.4), CT, 0 }, FRAME)
		box(ctx, "SideGlass", { 0.12, RH - CT - 0.1, D - 1.6 }, { sx * (W / 2 - 0.4), CT + (RH - CT) / 2, 0 }, {
			color = { 190, 210, 222 },
			material = "Glass",
			transparency = 0.62,
			reflectance = 0.1,
		})
	end

	-- Back wall with warm wooden slats
	box(ctx, "BackWall", { W - 0.8, RH - FL, 0.3 }, { 0, FL + (RH - FL) / 2, back - 0.4 }, { color = { 26, 26, 30 } })
	x = -(W / 2 - 1.05)
	while x <= W / 2 - 1.05 do
		box(ctx, "Slat", { 0.28, RH - FL - 0.2, 0.1 }, { x, FL + (RH - FL) / 2, back - 0.6 }, deco(WOOD, "Wood"))
		x += 0.55
	end
	box(ctx, "CoveLight", { W - 1.2, 0.1, 0.1 }, { 0, RH - 0.15, back - 0.75 }, neon(WARM))

	-- Menu board above the shopkeeper's head
	ctx.group = "Back"
	box(ctx, "MenuFrame", { 5.8, 2.6, 0.1 }, { 0, FL + 7.3, back - 0.7 }, deco({ 60, 62, 68 }, "Metal"))
	box(ctx, "MenuBoard", { 5.6, 2.4, 0.12 }, { 0, FL + 7.3, back - 0.8 }, {
		color = { 12, 12, 14 },
		solid = false,
		gui = gui("menu", accent, { lines = s.Menu or { string.upper(text) } }),
	})

	-- Shelves either side, with phone boxes (and cash on the sell stall)
	local shelfLen = W / 2 - 3.6
	if shelfLen >= 1.4 then
		local seed = if kind == "sell" then 5 else 2
		for _, sx in { -1, 1 } do
			for row, y in { FL + 4.4, FL + 6.0 } do
				local cx = sx * (2.6 + shelfLen / 2)
				box(ctx, "Shelf", { shelfLen, 0.12, 1 }, { cx, y, back - 1.15 }, deco({ 186, 146, 104 }, "Wood"))
				box(ctx, "ShelfLight", { shelfLen - 0.2, 0.05, 0.05 }, { cx, y - 0.09, back - 0.72 }, neon(WARM))
				local n = math.floor(shelfLen / 0.85)
				local step = shelfLen / n
				for i = 1, n do
					local bx = cx - shelfLen / 2 + (i - 0.5) * step
					seed = (seed * 7 + 3) % 11
					if kind == "sell" and row == 2 and i % 2 == 1 then
						-- bundles of cash
						for k = 0, 1 do
							local by = y + 0.06 + 0.1 + k * 0.2
							box(ctx, "Cash", { 0.62, 0.19, 0.4 }, { bx, by, back - 1.15 }, deco({ 86, 156, 96 }))
							box(ctx, "CashBand", { 0.14, 0.2, 0.41 }, { bx, by, back - 1.15 }, deco({ 236, 234, 222 }))
						end
					else
						local c = BOX_COLORS[seed % #BOX_COLORS + 1]
						if (i + row) % 4 == 0 then
							c = mix(accent, BLACK, 0.25)
						end
						box(ctx, "PhoneBox", { 0.6, 1, 0.24 }, { bx, y + 0.56, back - 1.15 }, deco(c))
						box(ctx, "PhoneBoxLid", { 0.62, 0.08, 0.26 }, { bx, y + 1.02, back - 1.15 }, deco(mix(c, WHITE, 0.35)))
					end
				end
			end
		end
	end

	------------------------------------------------------------------ roof
	ctx.group = "Roof"
	box(ctx, "Roof", { W + 1.2, 0.5, D + 1.6 }, { 0, RH + 0.25, -0.5 }, { color = { 26, 27, 31 } })
	box(ctx, "Fascia", { W + 1.3, 1, 0.25 }, { 0, RH + 0.2, front - 1.42 }, {
		color = { 34, 36, 40 },
		material = "Metal",
		tag = "StallTicker",
		gui = gui("ticker", accent, { text = s.Ticker or `{string.upper(text)} PHONES  *  OPEN NOW  *` }),
	})

	-- String of warm bulbs swagging under the roof edge
	if s.StringLights ~= false then
		local wire: Props = { color = { 24, 24, 26 }, solid = false, shadow = false }
		local bulb: Props = { color = { 255, 206, 130 }, material = "Neon", solid = false, shadow = false }
		local yA, zA = RH - 0.42, front - 1.58
		local ends = { -(W / 2 + 0.4), 0, W / 2 + 0.4 }
		for swag = 1, 2 do
			local x0, x1 = ends[swag], ends[swag + 1]
			local n = math.max(4, math.floor((x1 - x0) / 1.1 + 0.5))
			local sag = 0.55 + (x1 - x0) * 0.03
			local last: Vec = { x0, yA, zA }
			for i = 1, n do
				local t = i / n
				local point: Vec = { x0 + (x1 - x0) * t, yA - sag * 4 * t * (1 - t), zA }
				local dx, dy = point[1] - last[1], point[2] - last[2]
				local mid: Vec = { (point[1] + last[1]) / 2, (point[2] + last[2]) / 2, zA }
				add(ctx, "cyl", "Wire", { math.sqrt(dx * dx + dy * dy), 0.05, 0.05 }, mid, rotZ(math.deg(math.atan2(dy, dx))), wire)
				if i < n then
					ball(ctx, "Bulb", 0.13, { point[1], point[2] - 0.14, zA }, bulb)
				end
				last = point
			end
		end
	end
	box(ctx, "RoofGlow", { W + 1.3, 0.1, 0.1 }, { 0, RH - 0.32, front - 1.52 }, neon(accent))
	for _, sx in { -1, 1 } do
		box(ctx, "RoofGlow", { 0.1, 0.1, D + 1.6 }, { sx * (W / 2 + 0.62), RH + 0.02, -0.5 }, neon(accent))
	end
	for i, dx in { -W / 4, 0, W / 4 } do
		box(ctx, "Downlight", { 0.7, 0.05, 0.7 }, { dx, RH - 0.03, zc + 0.6 }, {
			color = WARM,
			material = "Neon",
			solid = false,
			shadow = false,
			light = { kind = "spot", color = WARM, brightness = if i == 2 then 1.6 else 1, range = 12, angle = 100, face = "Bottom" },
		})
	end
	box(ctx, "Downlight", { 0.7, 0.05, 0.7 }, { 0, RH - 0.03, back - 2 }, {
		color = WARM,
		material = "Neon",
		solid = false,
		shadow = false,
		light = { kind = "point", color = WARM, brightness = 0.8, range = 12, angle = 0, face = "Bottom" },
	})

	-- Big neon sign on the roof
	local SH = 2.8
	local SL = math.clamp(3.2 + 1.9 * #text, 6, W - 2.4)
	local signY = RH + 0.5 + 0.7 + SH / 2
	local signZ = front + 0.6
	for _, sx in { -1, 1 } do
		box(ctx, "SignPost", { 0.3, 0.8, 0.3 }, { sx * (SL / 2 - 1.6), RH + 0.85, signZ }, FRAME)
	end
	ctx.group = "Sign"
	box(ctx, "SignFace", { SL - SH, SH, 0.6 }, { 0, signY, signZ }, {
		color = { 12, 12, 15 },
		light = { kind = "spot", color = accent, brightness = 1.6, range = 16, angle = 110, face = "Front" },
		gui = gui("sign", accent, { text = text, twoSided = true }),
	})
	box(ctx, "SignRim", { SL - SH, SH + 0.36, 0.3 }, { 0, signY, signZ + 0.3 }, neon(accent))
	for _, sx in { -1, 1 } do
		-- a hair thinner than the face, so the round ends never flicker through the letters
		disc(ctx, "SignEnd", SH / 2, 0.56, { sx * (SL - SH) / 2, signY, signZ }, { color = { 12, 12, 15 } })
		disc(ctx, "SignRim", SH / 2 + 0.18, 0.3, { sx * (SL - SH) / 2, signY, signZ + 0.3 }, neon(accent))
	end
	motion("Sign", "flicker", { 0, signY, signZ }, 0, 0, 0, 0)

	-- Little neon OPEN sign hanging on the left
	if s.OpenSign ~= false then
		ctx.group = "OpenSign"
		local ox, oy, oz = -(W / 2 - 2.1), FL + 6.5, front + 1.2
		box(ctx, "OpenSign", { 2.2, 0.9, 0.12 }, { ox, oy, oz }, {
			color = { 14, 14, 16 },
			solid = false,
			gui = gui("open", { 255, 80, 180 }, { text = "OPEN" }),
		})
		for _, dx in { -0.8, 0.8 } do
			post(ctx, "Wire", 0.02, RH - oy - 0.45, { ox + dx, (oy + 0.45 + RH) / 2, oz }, deco({ 30, 30, 30 }))
		end
		motion("OpenSign", "flicker", { ox, oy, oz }, 0, 0, 0, 0)
	end

	------------------------------------------------------------------ on the counter
	ctx.group = "Items"
	local zi = zc + 0.5
	-- service bell
	post(ctx, "BellBase", 0.22, 0.06, { 0.9, CT + 0.03, zc - 0.05 }, deco({ 40, 40, 44 }, "Metal"))
	ball(ctx, "Bell", 0.18, { 0.9, CT + 0.1, zc - 0.05 }, { color = { 222, 182, 92 }, material = "Metal", reflectance = 0.2, solid = false })
	-- card reader
	box(ctx, "CardReader", { 0.45, 0.12, 0.75 }, { 1.7, CT + 0.06, zi + 0.2 }, deco({ 30, 30, 34 }))
	box(ctx, "CardReaderScreen", { 0.34, 0.02, 0.3 }, { 1.7, CT + 0.13, zi + 0.4 }, neon(mix(accent, WHITE, 0.4)))

	if kind == "sell" then
		-- cash register
		local rx = -W / 4
		box(ctx, "Register", { 1.7, 0.55, 1.1 }, { rx, CT + 0.275, zi + 0.35 }, { color = { 30, 31, 35 } })
		box(ctx, "Drawer", { 1.5, 0.1, 0.02 }, { rx, CT + 0.2, zi - 0.21 }, deco({ 70, 72, 78 }, "Metal"))
		box(ctx, "Keypad", { 0.8, 0.05, 0.45 }, { rx + 0.35, CT + 0.575, zi + 0.2 }, deco({ 54, 56, 62 }))
		add(ctx, "box", "RegisterScreen", { 0.9, 0.5, 0.07 }, { rx - 0.25, CT + 0.95, zi + 0.6 }, rotX(20), {
			color = { 10, 10, 12 },
			solid = false,
			gui = gui("display", accent, { text = "$$$" }),
		})
		-- cash and a phone being checked on a glowing tray
		for k = 0, 2 do
			local by = CT + 0.1 + k * 0.2
			box(ctx, "Cash", { 0.85, 0.19, 0.42 }, { W / 4 + 0.6, by, zi + 0.3 }, deco({ 86, 156, 96 }))
			box(ctx, "CashBand", { 0.16, 0.2, 0.43 }, { W / 4 + 0.6, by, zi + 0.3 }, deco({ 236, 234, 222 }))
		end
		box(ctx, "CheckTray", { 1.3, 0.04, 0.9 }, { W / 4 - 1, CT + 0.02, zi + 0.3 }, neon(accent, 0.2))
		box(ctx, "TradeInPhone", { 0.55, 0.06, 1.15 }, { W / 4 - 1, CT + 0.07, zi + 0.3 }, deco({ 40, 40, 46 }))
	else
		-- turning display phone
		local tx, tz = -W / 4, zi + 0.2
		ctx.group = "Turntable"
		post(ctx, "Turntable", 0.75, 0.1, { tx, CT + 0.05, tz }, { color = { 200, 200, 206 }, material = "Metal", solid = false })
		box(ctx, "DisplayPhone", { 0.62, 1.25, 0.08 }, { tx, CT + 0.73, tz }, {
			color = mix(accent, BLACK, 0.55),
			solid = false,
			gui = gui("screen", accent, { twoSided = false }),
		})
		motion("Turntable", "spin", { tx, CT, tz }, 0.8, 0, 0, 0)
		ctx.group = "Items"
		-- phones on clear stands
		for i, dx in { -0.5, 0.5 } do
			local px = W / 4 + dx
			box(ctx, "Stand", { 0.62, 0.06, 0.6 }, { px, CT + 0.03, zi + 0.2 }, { color = { 220, 235, 240 }, material = "Glass", transparency = 0.5, solid = false })
			add(ctx, "box", "DisplayPhone", { 0.58, 1.2, 0.07 }, { px, CT + 0.66, zi + 0.3 }, rotX(15), {
				color = if i == 1 then { 236, 236, 232 } else { 28, 28, 32 },
				solid = false,
				gui = gui("screen", accent),
			})
		end
		-- shopping bag at the end of the counter
		local bx = W / 2 - 1.6
		box(ctx, "Bag", { 0.8, 0.95, 0.36 }, { bx, CT + 0.475, zi + 0.45 }, deco(mix(accent, BLACK, 0.2)))
		for _, dx in { -0.2, 0.2 } do
			box(ctx, "BagHandle", { 0.04, 0.3, 0.04 }, { bx + dx, CT + 1.1, zi + 0.45 }, deco(WHITE))
		end
		box(ctx, "BagHandle", { 0.44, 0.04, 0.04 }, { bx, CT + 1.25, zi + 0.45 }, deco(WHITE))
	end

	------------------------------------------------------------------ posters and chalkboard
	ctx.group = "Signs"
	local poster = s.Poster or { if kind == "sell" then "CASH FOR PHONES" else "NEW PHONES", if kind == "sell" then "Any phone, paid on the spot" else "Fresh from the farm every day" }
	for _, sx in { -1, 1 } do
		box(ctx, "Poster", { 0.1, 2.4, 3.8 }, { sx * (W / 2 - 0.22), FL + 1.75, 0.6 }, {
			color = { 14, 14, 18 },
			gui = gui("poster", accent, { lines = poster, face = if sx > 0 then "Right" else "Left", icon = icon }),
		})
	end
	local bx, bz = -(W / 2 - 1.3), front - 2.3
	local boardLines = s.Board or { "OPEN", if kind == "sell" then "We buy phones" else "Phones in stock", "Come on in!" }
	add(ctx, "box", "Chalkboard", { 1.7, 2.5, 0.08 }, { bx, 1.22, bz - 0.26 }, rotX(12), {
		color = { 120, 86, 56 },
		material = "Wood",
		gui = gui("board", accent, { lines = boardLines }),
	})
	add(ctx, "box", "ChalkboardBack", { 1.7, 2.5, 0.08 }, { bx, 1.22, bz + 0.26 }, rotX(-12), { color = { 120, 86, 56 }, material = "Wood" })

	------------------------------------------------------------------ plants
	if s.Plants ~= false then
		ctx.group = "Plants"
		for _, sx in { -1, 1 } do
			local px = sx * (W / 2 + 0.95)
			post(ctx, "Pot", 0.5, 1.2, { px, 0.6, front + 0.9 }, { color = { 68, 68, 74 }, material = "Concrete" })
			ball(ctx, "Leaves", 0.78, { px, 1.75, front + 0.9 }, { color = { 58, 92, 52 }, material = "LeafyGrass" })
			ball(ctx, "Leaves", 0.55, { px + sx * 0.3, 2.3, front + 1.1 }, { color = { 66, 104, 58 }, material = "LeafyGrass" })
		end
	end

	------------------------------------------------------------------ floor circle and floating icon
	local padX, padZ = f.padX or 0, f.padZ or (front - 4.2)
	local R = math.clamp(f.padR or 2.3, 1.5, 4.5)
	ctx.group = "Pad"
	post(ctx, "PadRing", R, 0.06, { padX, 0.03, padZ }, neon(accent))
	post(ctx, "PadDisc", R - 0.22, 0.08, { padX, 0.04, padZ }, { color = { 18, 18, 22 }, solid = false })
	post(ctx, "PadInnerRing", R * 0.62, 0.09, { padX, 0.045, padZ }, neon(accent))
	post(ctx, "PadCentre", R * 0.62 - 0.12, 0.1, { padX, 0.05, padZ }, { color = { 24, 24, 30 }, solid = false })
	ctx.group = "PadGlow"
	post(ctx, "PadGlow", R + 0.7, 0.03, { padX, 0.015, padZ }, neon(accent, 0.88))
	motion("PadGlow", "breathe", { padX, 0, padZ }, 0, 0, 0.82, 0.95, R)

	ctx.group = "Token"
	local ty = 4.4
	disc(ctx, "Token", 0.8, 0.22, { padX, ty, padZ }, {
		color = { 16, 16, 20 },
		solid = false,
		light = { kind = "point", color = accent, brightness = 1.2, range = 10, angle = 0, face = "Front" },
		sparkles = mix(accent, WHITE, 0.4),
	})
	disc(ctx, "TokenRim", 0.88, 0.16, { padX, ty, padZ }, neon(accent))
	box(ctx, "TokenIcon", { 1.2, 1.2, 0.24 }, { padX, ty, padZ }, {
		color = accent,
		transparency = 1,
		solid = false,
		shadow = false,
		gui = gui("token", accent, { icon = icon, twoSided = true }),
	})
	motion("Token", "spin", { padX, ty, padZ }, 1.4, 0.22, 0, 0)

	return { prims = ctx.prims, motions = motions, width = W, depth = D }
end

return StallGeometry
]]></string>
      </Properties>
    </Item>
  </Item>
</roblox>